name: Release Theme

on:
  push:
    branches:
      - main

jobs:
  release:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Read current version
        id: version
        run: |
          VERSION=$(grep "Version:" style.css | awk '{print $2}')
          echo "current=$VERSION" >> $GITHUB_OUTPUT

      - name: Increment patch version
        id: bump
        run: |
          IFS='.' read -r major minor patch <<< "${{ steps.version.outputs.current }}"
          patch=$((patch + 1))
          NEW_VERSION="$major.$minor.$patch"

          echo "new=$NEW_VERSION" >> $GITHUB_OUTPUT

          sed -i "s/Version: .*/Version: $NEW_VERSION/" style.css

      - name: Commit updated version
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"

          git add style.css
          git commit -m "Bump version to ${{ steps.bump.outputs.new }}" || echo "No changes"

          git tag ${{ steps.bump.outputs.new }}

          git push
          git push origin ${{ steps.bump.outputs.new }}

      - name: Create release ZIP
        run: |
          zip -r rrh-divi-child.zip . \
            -x "*.git*" \
            -x "node_modules/*" \
            -x "src/*"

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.bump.outputs.new }}
          files: rrh-divi-child.zip
